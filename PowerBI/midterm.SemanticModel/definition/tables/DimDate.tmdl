	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2013,1,1), DATE(2017,12,31)),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "MonthNo", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "YearMonth", FORMAT([Date], "YYYY-MM"),
				    "DayOfWeek", FORMAT([Date], "ddd")
				)

	annotation PBI_Id = 3c5861d4199949d1a61265fe2739842b

