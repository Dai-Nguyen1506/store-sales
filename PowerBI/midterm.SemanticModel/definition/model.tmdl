annotation PBI_ProTooling = ["DevMode"]

ref table DimHolidays
ref table FactOil
ref table DimStores
ref table FactSales
ref table FactTransactions
ref table DimDate
ref table DimProduct
ref table '00_Core Measures'
ref table 04_Store
ref table 01_Overview

