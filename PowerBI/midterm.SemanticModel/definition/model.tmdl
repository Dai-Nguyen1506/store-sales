model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: vi-VN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimHolidays","FactOil","DimStores","FactSales","FactTransactions","RootPath"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimHolidays
ref table FactOil
ref table DimStores
ref table FactSales
ref table FactTransactions
ref table DimDate

ref cultureInfo en-US

