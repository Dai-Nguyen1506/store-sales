	column 'Quarter No' =
			
			QUARTER ( DimDate[Date] )
		formatString: 0
		lineageTag: e4c39e4d-344f-4bb5-8501-46fc6f28d43f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Year Quarter' =
			
			FORMAT ( DimDate[Date], "YYYY" )
			    & " Q"
			    & QUARTER ( DimDate[Date] )
		lineageTag: 4699ec35-7c67-4e1f-b1b6-5aa3bce21490
		summarizeBy: none
		sortByColumn: 'Year Quarter Sort'

		annotation SummarizationSetBy = Automatic

	column 'Year Quarter Sort' =
			
			YEAR ( DimDate[Date] ) * 100
			    + QUARTER ( DimDate[Date] )
		formatString: 0
		lineageTag: a978f583-109f-4a72-bb87-ce3c262391a6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Month Start' =
			
			DATE (
			    YEAR ( DimDate[Date] ),
			    MONTH ( DimDate[Date] ),
			    1
			)
		formatString: mmmm yyyy
		lineageTag: 7c14ff0b-c839-4818-b275-0ac4c27f75bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition DimDate = calculated
		mode: import
		source =
				
				VAR MinDate =
				    MINX ( FactSales, FactSales[Date] )
				VAR MaxDate =
				    MAXX ( FactSales, FactSales[Date] )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Month No", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMM" ),
				    "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Week No", WEEKNUM ( [Date], 2 ),
				    "Day", DAY ( [Date] ),
				    "Day Name", FORMAT ( [Date], "DDD" ),
				    "Day Of Week", WEEKDAY ( [Date], 2 ),
				    "Is Weekend", WEEKDAY ( [Date], 2 ) >= 6
				)

	annotation PBI_Id = 3c5861d4199949d1a61265fe2739842b

